# ==========================================
# CAL.COM : AGENCY OS CONFIGURATION
# ==========================================

# --- 1. ROUTAGE & DOMAINE (CADDY) ---
# Remplace par le vrai domaine de ton agence
NEXT_PUBLIC_WEBAPP_URL='https://cal.ton-agence.com'
NEXT_PUBLIC_WEBSITE_URL='https://cal.ton-agence.com'
NEXTAUTH_URL='https://cal.ton-agence.com'
NEXT_PUBLIC_API_V2_URL='https://cal.ton-agence.com/api/v2'

# --- 2. BASE DE DONNÉES & CACHE ---
# Ces variables alimentent directement ton docker-compose
POSTGRES_USER=calcom_user
POSTGRES_PASSWORD=GénèreUnMotDePasseSQLFortIci
POSTGRES_DB=calendso
# Laissent Caddy et Docker gérer la résolution interne
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@calcom-db:5432/${POSTGRES_DB}"
DATABASE_DIRECT_URL=${DATABASE_URL}
REDIS_URL="redis://calcom-redis:6379"

# --- 3. SÉCURITÉ & CHIFFREMENT (CRITIQUE) ---
# À générer sur ton serveur via la commande : openssl rand -base64 32
NEXTAUTH_SECRET=
# À générer sur ton serveur via la commande : openssl rand -base64 24
CALENDSO_ENCRYPTION_KEY=

# --- 4. CONFIGURATION AGENCE ---
NEXT_PUBLIC_APP_NAME="Nom de ton Agence"
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS="contact@ton-agence.com"
NEXT_PUBLIC_COMPANY_NAME="Ton Agence"
# CRITIQUE : Empêche les inconnus de créer un compte sur ton serveur et de saturer ton VPS
NEXT_PUBLIC_DISABLE_SIGNUP=true

# --- 5. EMAILS (SMTP OBLIGATOIRE) ---
# Cal.com a besoin du SMTP pour envoyer les invitations Google Meet / Zoom
EMAIL_FROM='notifications@ton-agence.com'
EMAIL_FROM_NAME='Agenda - Ton Agence'
EMAIL_SERVER_HOST='smtp.ton-serveur-mail.com'
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER='ton-email-smtp'
EMAIL_SERVER_PASSWORD='ton-mot-de-passe-smtp'

# --- 6. OPTIMISATIONS ---
CALCOM_TELEMETRY_DISABLED=1
NODE_ENV=production
# Force l'heure du serveur en UTC pour éviter les bugs de fuseaux horaires dans le conteneur
TZ=UTC
